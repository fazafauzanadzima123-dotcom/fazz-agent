# Copy to secrets.properties (git-ignored) and fill in.
# These are PUBLIC client identifiers, not secrets: the Supabase anon key is designed to ship in apps.
# The Gemini API key must NEVER be placed here - it lives only in the Supabase secret GEMINI_API_KEY.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
